# ChirpStack MQTT Subscriber — example configuration
# Copy to `.env` and adjust. All values are read as environment variables.

# Broker connection
MQ_BROKER_HOST=localhost
MQ_BROKER_PORT=1883
MQ_BROKER_TLS=true

# TLS material (PEM). Omit MQ_CA_CERT to use the system root store.
# MQ_CA_CERT=/path/to/ca.pem
# MQ_CLIENT_CERT=/path/to/client.pem
# MQ_CLIENT_KEY=/path/to/client-key.pem

# Broker credentials (optional)
# MQ_USERNAME=mqtt-user
# MQ_PASSWORD=mqtt-pass

# MQTT client id (random when unset)
# MQ_CLIENT_ID=mq-subscriber

# Application ID used as the default for `mq-subscriber downlink` (optional;
# the downlink command also accepts --application-id).
# MQ_APPLICATION_ID=2ad6bbd4-7ee9-408f-8948-3d32cf3dba06

# Subscription topic filter(s), v1
# MQ_TOPICS takes precedence over MQ_TOPIC when set (comma-separated list).
# MQ_TOPICS=application/2ad6bbd4-7ee9-408f-8948-3d32cf3dba06/device/+/event/#,application/9f0e.../device/+/event/#
MQ_TOPIC=application/+/device/+/event/#
MQ_QOS=0

# Handlers
MQ_ENABLE_STDOUT=true
MQ_ENABLE_SQLITE=true
MQ_SQLITE_PATH=events.db

# Logging
RUST_LOG=mq_subscriber=info
